# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgres://ato:ato@localhost:5432/ato?sslmode=disable
INGEST_TOKEN=dev-ingest-token
ANALYST_TOKEN=dev-analyst-token
CONFIG_PATH=config.yaml
PORT=8080
# Hosted deployment options. Leave empty for the local defaults.
# ATO_MODE=shadow
# MIGRATION_DATABASE_URL=<direct PostgreSQL URL, when different from DATABASE_URL>
